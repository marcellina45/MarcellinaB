public class Zaposleni {
	private String ime;
	private String prezime;
	private int godine_staza;
	private double plata;

	public Zaposleni(String ime, String prezime, int godine_staza, double plata) {
		
		this.ime= ime;
		this.prezime = prezime;
		this.godine_staza = godine_staza;
		this.plata = plata;
		
		setPlata(plata);
		
		if(plata < 800) {
			plata = plata + (plata * 6)/ 100;
		}
		
		
	}

	public String getIme() {
		return ime;
	}

	public void setIme(String ime) {
		this.ime = ime;
	}

	public String getPrezime() {
		return prezime;
	}

	public void setPrezime(String prezime) {
		this.prezime = prezime;
	}

	public int getGodine_staza() {
		return godine_staza;
	}

	public void setGodine_staza(int godine_staza) {
		this.godine_staza = godine_staza;
		if(godine_staza < 1) {
			System.out.println("Greska");
			this.godine_staza = 0;
		}else {
			this.godine_staza = godine_staza;
		}
	}

	public double getPlata() {
		return plata;
	}

	public void setPlata(double plata) {
		this.plata = plata;
	}
	
	public void provjeriUvecaj() {
		
		if(this.plata < 800 && this.godine_staza > 10) {
			double staraPlata = this.plata;
			double novaPlata = staraPlata * 1.06;
			System.out.println("Stara plata od " + staraPlata + " je uvecana na " + novaPlata);
			
		}
	}
	public void ispisi() {
		System.out.println("Zaposleni " + ime + " " + prezime + " koji radi u nasoj firmi " + godine_staza);
	}
	
	public void najvecaPlata() {
		
	}

	public static void main(String[] args) {
		Zaposleni z1 = new Zaposleni("Nikolina ", "Nikolic",3,1000);
		
		z1.ispisi();
		z1.provjeriUvecaj();
		
	}
	
	
